ial;fontSize=20;fontColor=#18354A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1902" y="1345" width="166" height="24" as="geometry"/></mxCell><mxCell id="dimensions-t32-0" value="WB-MAO4" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#18354A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="972" y="1393" width="426" height="24" as="geometry"/></mxCell><mxCell id="dimensions-t33-0" value="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#18354A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1422" y="1393" width="66" height="24" as="geometry"/></mxCell><mxCell id="dimensions-t34-0" value="36 × 90 × 58 мм" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#18354A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1512" y="1393" width="366" height="24" as="geometry"/></mxCell><mxCell id="dimensions-t35-0" value="2" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#18354A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1902" y="1393" width="166" height="24" as="geometry"/></mxCell><mxCell id="dimensions-t36-0" value="WBE2-I-RS485-ISO" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#18354A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="972" y="1441" width="426" height="24" as="geometry"/></mxCell><mxCell id="dimensions-t37-0" value="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#18354A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1422" y="1441" width="66" height="24" as="geometry"/></mxCell><mxCell id="dimensions-t38-0" value="Внутри корпуса WB" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#18354A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1512" y="1441" width="366" height="24" as="geometry"/></mxCell><mxCell id="dimensions-t39-0" value="0" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#18354A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1902" y="1441" width="166" height="24" as="geometry"/></mxCell><mxCell id="p5-important" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="60" y="1640" width="2080" height="185" as="geometry"/></mxCell><mxCell id="p5-important-shape" value="" style="rounded=1;arcSize=8;fillColor=#FFF7E9;strokeColor=#A76B20;strokeWidth=1.6;" vertex="1" connectable="0" parent="p5-important"><mxGeometry width="2080" height="185" as="geometry"/></mxCell><mxCell id="p5-important-text0" value="Что означает итог для выбора щита" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=25;fontColor=#18354A;fontStyle=1;" vertex="1" parent="p5-important"><mxGeometry x="18" y="18" width="2044" height="31" as="geometry"/></mxCell><mxCell id="p5-important-text1" value="При размещении в один ряд: 390 мм корпусов; с показанным сервисным местом ~20 мм — около 410 мм, плюс упоры и другие зазоры." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p5-important"><mxGeometry x="18" y="58" width="2044" height="29" as="geometry"/></mxCell><mxCell id="p5-important-text2" value="22 DIN — сумма каталожных модульностей. Она не вычисляется делением 390 на условные 18 мм: корпуса имеют ширины 106 / 53 / 36 мм." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p5-important"><mxGeometry x="18" y="87" width="2044" height="29" as="geometry"/></mxCell><mxCell id="p5-important-text3" value="Высота 90 мм и глубина 58 мм — табличные размеры корпуса. Защёлки, разъёмы, изгибы кабелей, антенна и кабель-каналы требуют места." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p5-important"><mxGeometry x="18" y="116" width="2044" height="29" as="geometry"/></mxCell><mxCell id="p5-important-text4" value="Не включены: БП / ИБП, реле, контакторы, автоматы, клеммы, Новатек, MAP3EV, TUF, ПЧ и HMI. Габарит всего шкафа пока не определён." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p5-important"><mxGeometry x="18" y="145" width="2044" height="29" as="geometry"/></mxCell><mxCell id="dimensions-t40-0" value="Основание: D-305–D-311, D-322–D-334; карта I/O и интерфейс проекта. Источники и проверки — README.md." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#526879;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1861" width="2080" height="22" as="geometry"/></mxCell><mxCell id="dimensions-t41-0" value="Названия блоков и линии — функциональные обозначения. Клеммы, адреса, номиналы и монтажные каналы не назначены." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#526879;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1888" width="2080" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cabinet-main" name="Предварительная компоновка · основной щит"><mxGraphModel dx="2700" dy="2460" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="2460" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cabinet-main-banner" value="" style="rounded=1;arcSize=4;fillColor=#FFF7E9;strokeColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="162" width="2580" height="46" as="geometry"/></mxCell><mxCell id="cabinet-shell" value="" style="rounded=1;arcSize=4;fillColor=#E7EDF1;strokeColor=#18354A;" vertex="1" connectable="0" parent="1"><mxGeometry x="140" y="320" width="1400" height="1960" as="geometry"/></mxCell><mxCell id="mounting-plate" value="" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#CCD8E0;" vertex="1" connectable="0" parent="1"><mxGeometry x="210" y="390" width="1260" height="1820" as="geometry"/></mxCell><mxCell id="rail-left-0" value="" style="rounded=1;arcSize=4;fillColor=#B7C4CD;strokeColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="308" y="544" width="588" height="12.6" as="geometry"/></mxCell><mxCell id="rail-left-1" value="" style="rounded=1;arcSize=4;fillColor=#B7C4CD;strokeColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="308" y="831" width="588" height="12.6" as="geometry"/></mxCell><mxCell id="rail-left-2" value="" style="rounded=1;arcSize=4;fillColor=#B7C4CD;strokeColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="308" y="1160" width="588" height="12.6" as="geometry"/></mxCell><mxCell id="rail-left-3" value="" style="rounded=1;arcSize=4;fillColor=#B7C4CD;strokeColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="308" y="1440" width="588" height="12.6" as="geometry"/></mxCell><mxCell id="rail-left-4" value="" style="rounded=1;arcSize=4;fillColor=#B7C4CD;strokeColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="308" y="1671" width="588" height="12.6" as="geometry"/></mxCell><mxCell id="rail-left-5" value="" style="rounded=1;arcSize=4;fillColor=#B7C4CD;strokeColor=