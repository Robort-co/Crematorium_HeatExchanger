" width="464" height="28" as="geometry"/></mxCell><mxCell id="p3-rs1-text3" value="Адреса, скорость и проводку проверить." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#526879;fontStyle=0;" vertex="1" parent="p3-rs1"><mxGeometry x="18" y="112" width="464" height="28" as="geometry"/></mxCell><mxCell id="p3-rs2" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="600" y="1375" width="500" height="145" as="geometry"/></mxCell><mxCell id="p3-rs2-shape" value="" style="rounded=1;arcSize=8;fillColor=#EDF5FB;strokeColor=#286A9B;strokeWidth=1.6;" vertex="1" connectable="0" parent="p3-rs2"><mxGeometry width="500" height="145" as="geometry"/></mxCell><mxCell id="p3-rs2-text0" value="RS-485 №2 ↔ приборы" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#18354A;fontStyle=1;" vertex="1" parent="p3-rs2"><mxGeometry x="18" y="18" width="464" height="29" as="geometry"/></mxCell><mxCell id="p3-rs2-text1" value="TUF-2000B + WB-MAP3EV" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#526879;fontStyle=0;" vertex="1" parent="p3-rs2"><mxGeometry x="18" y="56" width="464" height="28" as="geometry"/></mxCell><mxCell id="p3-rs2-text2" value="Обмен Modbus; выводы A / B порта 2." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#526879;fontStyle=0;" vertex="1" parent="p3-rs2"><mxGeometry x="18" y="84" width="464" height="28" as="geometry"/></mxCell><mxCell id="p3-rs2-text3" value="Совместимость общей линии проверить." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#526879;fontStyle=0;" vertex="1" parent="p3-rs2"><mxGeometry x="18" y="112" width="464" height="28" as="geometry"/></mxCell><mxCell id="p3-sidebus" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="1140" y="1375" width="1200" height="145" as="geometry"/></mxCell><mxCell id="p3-sidebus-shape" value="" style="rounded=1;arcSize=8;fillColor=#EDF8F4;strokeColor=#277A69;strokeWidth=1.6;" vertex="1" connectable="0" parent="p3-sidebus"><mxGeometry width="1200" height="145" as="geometry"/></mxCell><mxCell id="p3-sidebus-text0" value="Боковая шина WBIO · показан вариант порядка модулей" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=24;fontColor=#18354A;fontStyle=1;" vertex="1" parent="p3-sidebus"><mxGeometry x="18" y="18" width="1164" height="30" as="geometry"/></mxCell><mxCell id="p3-sidebus-text1" value="Модули стыкуются справа от WB. Порядок DI → DO → DO показан для компоновки, адреса не назначены." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p3-sidebus"><mxGeometry x="18" y="57" width="1164" height="29" as="geometry"/></mxCell><mxCell id="p3-sidebus-text2" value="Входные и выходные цепи подключаются к модулям WBIO; это не отдельные устройства RS-485." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p3-sidebus"><mxGeometry x="18" y="86" width="1164" height="29" as="geometry"/></mxCell><mxCell id="p3-sidebus-text3" value="A1…A4 / W1…W2 контроллера технологическим функциям не назначены." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p3-sidebus"><mxGeometry x="18" y="115" width="1164" height="29" as="geometry"/></mxCell><mxCell id="p3-read-labels" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="60" y="1580" width="2280" height="180" as="geometry"/></mxCell><mxCell id="p3-read-labels-shape" value="" style="rounded=1;arcSize=8;fillColor=#FFF7E9;strokeColor=#A76B20;strokeWidth=1.6;" vertex="1" connectable="0" parent="p3-read-labels"><mxGeometry width="2280" height="180" as="geometry"/></mxCell><mxCell id="p3-read-labels-text0" value="Заводские надписи сохранены; проектное назначение клемм не добавлено" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=25;fontColor=#18354A;fontStyle=1;" vertex="1" parent="p3-read-labels"><mxGeometry x="18" y="18" width="2244" height="31" as="geometry"/></mxCell><mxCell id="p3-read-labels-text1" value="Напечатанные на корпусах диапазоны питания и токи — данные изделия, а не выбранные номиналы цепей шкафа." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p3-read-labels"><mxGeometry x="18" y="58" width="2244" height="29" as="geometry"/></mxCell><mxCell id="p3-read-labels-text2" value="Наличие значков GSM / SIM на типовой крышке не означает установленный модем в выбранной комплектации." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p3-read-labels"><mxGeometry x="18" y="87" width="2244" height="29" as="geometry"/></mxCell><mxCell id="p3-read-labels-text3" value="Стрелки относятся к группам портов / входов / выходов. Конкретные клеммы каждого датчика или механизма — проверить при проектировании шкафа." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p3-read-labels"><mxGeometry x="18" y="116" width="2244" height="29" as="geometry"/></mxCell><mxCell id="p3-read-labels-text4" value="Размеры корпусов и расчёт места показаны на листе 5. Изображения на этом листе увеличены и не предназначены для измерения линейкой." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p3-read-labels"><mxGeometry x="18" y="145" width="2244" height="29" as="geometry"/></mxCell><mxCell id="physical-wb-t11-0" value="Основание: D-305–D-311, D-322–D-334; карта I/O и интерфейс проекта. Источники и проверки — README.md." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#526879;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1821" width="2280" height="22" as="geometry"/></mxCell><mxCell id="physical-wb-t12-0" value="Названия блоков и линии — функциональные обозначения. Клеммы, адреса, номиналы и монтажные каналы не назначены." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#526879;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1848" width="2280" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="physical-analog" name="Внешний вид · аналоговые модули"><mxGraphModel dx="2200" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="physical-analog-banner" value="" style="rounded=1;arcSize=4;fillColor=#FFF7E9;strokeColor=none;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="162" width="2080" height="46" as="geometry"/></mxCell><mxCell id="p4-mai1" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,%0D%0A%0D%0A%3C!--%20Creator%3A%20CorelDRAW%20--%3E%0D%