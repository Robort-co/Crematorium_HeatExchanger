я и ОС → WB-MAI6 №2" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=25;fontColor=#18354A;fontStyle=1;" vertex="1" parent="p4-ai"><mxGeometry x="18" y="18" width="614" height="31" as="geometry"/></mxCell><mxCell id="p4-ai-text1" value="2 давления до / после НГ: 4–20 мА." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p4-ai"><mxGeometry x="18" y="58" width="614" height="28" as="geometry"/></mxCell><mxCell id="p4-ai-text2" value="Обратная связь ШОД: 0–10 В." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p4-ai"><mxGeometry x="18" y="86" width="614" height="28" as="geometry"/></mxCell><mxCell id="p4-ai-text3" value="3 измерения. Конкретные INx не назначены." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p4-ai"><mxGeometry x="18" y="114" width="614" height="28" as="geometry"/></mxCell><mxCell id="p4-ai-text4" value="Нагрузка выхода ШОД и цепи токовых петель" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p4-ai"><mxGeometry x="18" y="142" width="614" height="28" as="geometry"/></mxCell><mxCell id="p4-ai-text5" value="— проверить при проектировании шкафа." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="p4-ai"><mxGeometry x="18" y="170" width="614" height="28" as="geometry"/></mxCell><mxCell id="p4-shod" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="1490