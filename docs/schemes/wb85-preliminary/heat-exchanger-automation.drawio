5-total-shape" value="" style="rounded=1;arcSize=8;fillColor=#EDF5FB;strokeColor=#286A9B;strokeWidth=1.6;" vertex="1" connectable="0" parent="p5-total"><mxGeometry width="2080" height="105" as="geometry"/></mxCell><mxCell id="p5-total-text0" value="390 мм корпусов · 22 DIN-модуля" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=34;fontColor=#18354A;fontStyle=1;" vertex="1" parent="p5-total"><mxGeometry x="18" y="18" width="2044" height="40" as="geometry"/></mxCell><mxCell id="p5-total-text1" value="Это сумма ширин приборов, а не готовая ширина шкафа. Упоры, зазоры, проводка и остальное оборудование сюда не входят." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#526879;fontStyle=0;" vertex="1" parent="p5-total"><mxGeometry x="18" y="67" width="2044" height="28" as="geometry"/></mxCell><mxCell id="dimensions-t4-0" value="Вариант размещения на двух рядах · окончательная компоновка шкафа не утверждена" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=25;fontColor=#18354A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="2080" height="26" as="geometry"/></mxCell><mxCell id="dimensions-t5-0" value="~20" style="text;html=0;align=center;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#A76B20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1145" y="650" width="55" height="29" as="geometry"/></mxCell><mxCell id="dimensions-t5-1" value="мм" style="text;html=0;align=center;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#A76B20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1145" y="679" width="55" height="29" as="geometry"/></mxCell><mxCell id="dimensions-t6-0" value="WB8.5 + DI + DO + DO · корпуса 248 мм / 14 DIN" style=