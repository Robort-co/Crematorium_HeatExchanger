ometry"/></mxCell><mxCell id="cabinet-ups-t1-0" value="Отдельный ИБП · дверная зона · оценка запаса" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=38;fontColor=#18354A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="65" width="2380" height="44" as="geometry"/></mxCell><mxCell id="cabinet-ups-t2-0" value="Архивный эскиз ред.03: ИБП ≥30 мин — новый кандидат корпуса 1200 × 800 × 400 мм; см. CABINET_SPECIFICATION.md." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#526879;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="116" width="2380" height="26" as="geometry"/></mxCell><mxCell id="cabinet-ups-t3-0" value="ПРЕДВАРИТЕЛЬНАЯ ФУНКЦИОНАЛЬНАЯ СХЕМА  •  НЕ ДЛЯ МОНТАЖА  •  15.11.2026  •  Лист 7/7" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#A76B20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="78" y="175" width="2344" height="22" as="geometry"/></mxCell><mxCell id="ups-head" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="60" y="250" width="1100" height="150" as="geometry"/></mxCell><mxCell id="ups-head-shape" value="" style="rounded=1;arcSize=8;fillColor=#FFF7E9;strokeColor=#A76B20;strokeWidth=1.6;" vertex="1" connectable="0" parent="ups-head"><mxGeometry width="1100" height="150" as="geometry"/></mxCell><mxCell id="ups-head-text0" value="Корпус ИБП · ориентир 800 × 600 × 400 мм*" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=29;fontColor=#18354A;fontStyle=1;" vertex="1" parent="ups-head"><mxGeometry x="18" y="18" width="1064" height="35" as="geometry"/></mxCell><mxCell id="ups-head-text1" value="Размеры В × Ш × Г. Это условный объём для подбора," style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=24;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-head"><mxGeometry x="18" y="62" width="1064" height="34" as="geometry"/></mxCell><mxCell id="ups-head-text2" value="вместимость конкретного ИБП и аккумуляторов не подтверждена." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=24;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-head"><mxGeometry x="18" y="96" width="1064" height="34" as="geometry"/></mxCell><mxCell id="ups-device" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="340" y="550" width="400" height="240" as="geometry"/></mxCell><mxCell id="ups-device-shape" value="" style="rounded=1;arcSize=8;fillColor=#FFF7E9;strokeColor=#A76B20;strokeWidth=1.6;dashed=1;dashPattern=8 6;" vertex="1" connectable="0" parent="ups-device"><mxGeometry width="400" height="240" as="geometry"/></mxCell><mxCell id="ups-device-text0" value="ИБП — модель не выбрана" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=25;fontColor=#18354A;fontStyle=1;" vertex="1" parent="ups-device"><mxGeometry x="18" y="18" width="364" height="31" as="geometry"/></mxCell><mxCell id="ups-device-text1" value="Условная зона" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-device"><mxGeometry x="18" y="58" width="364" height="30" as="geometry"/></mxCell><mxCell id="ups-device-text2" value="400 × 240 × 250 мм*" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-device"><mxGeometry x="18" y="88" width="364" height="30" as="geometry"/></mxCell><mxCell id="ups-device-text3" value="По D-146: ≥600 Вт и ≥600 ВА." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-device"><mxGeometry x="18" y="118" width="364" height="30" as="geometry"/></mxCell><mxCell id="ups-device-text4" value="Это требование мощности," style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-device"><mxGeometry x="18" y="148" width="364" height="30" as="geometry"/></mxCell><mxCell id="ups-device-text5" value="а не расчёт автономности." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-device"><mxGeometry x="18" y="178" width="364" height="30" as="geometry"/></mxCell><mxCell id="cabinet-ups-t4-0" value="Трассы / вводы / защита — уточнить" style="text;html=0;align=center;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#18354A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="330" y="830" width="420" height="26" as="geometry"/></mxCell><mxCell id="ups-battery" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="340" y="900" width="400" height="200" as="geometry"/></mxCell><mxCell id="ups-battery-shape" value="" style="rounded=1;arcSize=8;fillColor=#FFF7E9;strokeColor=#A76B20;strokeWidth=1.6;dashed=1;dashPattern=8 6;" vertex="1" connectable="0" parent="ups-battery"><mxGeometry width="400" height="200" as="geometry"/></mxCell><mxCell id="ups-battery-text0" value="Аккумуляторы и полка" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=24;fontColor=#18354A;fontStyle=1;" vertex="1" parent="ups-battery"><mxGeometry x="18" y="18" width="364" height="30" as="geometry"/></mxCell><mxCell id="ups-battery-text1" value="Условная зона 400 × 200 × 250 мм*" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-battery"><mxGeometry x="18" y="57" width="364" height="30" as="geometry"/></mxCell><mxCell id="ups-battery-text2" value="Тип, число, ёмкость, масса" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-battery"><mxGeometry x="18" y="87" width="364" height="30" as="geometry"/></mxCell><mxCell id="ups-battery-text3" value="и крепление не подтверждены." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-battery"><mxGeometry x="18" y="117" width="364" height="30" as="geometry"/></mxCell><mxCell id="cabinet-ups-t5-0" value="Свободное место не подтверждает охлаждение." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#526879;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="300" y="1140" width="480" height="27" as="geometry"/></mxCell><mxCell id="cabinet-ups-t5-1" value="Проверить вентиляцию и допустимую нагрузку полки." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#526879;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="300" y="1167" width="480" height="27" as="geometry"/></mxCell><mxCell id="cabinet-ups-t6-0" value="600 мм*" style="text;html=0;align=center;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#18354A;fontStyle=0;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="350" y="1266" width="380" height="22" as="geometry"/></mxCell><mxCell id="power-boundary" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="60" y="1380" width="1100" height="220" as="geometry"/></mxCell><mxCell id="power-boundary-shape" value="" style="rounded=1;arcSize=8;fillColor=#EDF5FB;strokeColor=#286A9B;strokeWidth=1.6;" vertex="1" connectable="0" parent="power-boundary"><mxGeometry width="1100" height="220" as="geometry"/></mxCell><mxCell id="power-boundary-text0" value="Питание сохраняет разделение D-146" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=27;fontColor=#18354A;fontStyle=1;" vertex="1" parent="power-boundary"><mxGeometry x="18" y="18" width="1064" height="33" as="geometry"/></mxCell><mxCell id="power-boundary-text1" value="Вход ИБП: источник / цепь защиты уточняются по силовой схеме." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="power-boundary"><mxGeometry x="18" y="60" width="1064" height="33" as="geometry"/></mxCell><mxCell id="power-boundary-text2" value="Выход ИБП → управление / измерения АСУ и привод ШТ." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="power-boundary"><mxGeometry x="18" y="93" width="1064" height="33" as="geometry"/></mxCell><mxCell id="power-boundary-text3" value="Сеть / ДГУ → силовые потребители, включая ПЧ и насосы." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="power-boundary"><mxGeometry x="18" y="126" width="1064" height="33" as="geometry"/></mxCell><mxCell id="power-boundary-text4" value="АВР / ДГУ не добавлены внутрь щита как выбранное оборудование." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="power-boundary"><mxGeometry x="18" y="159" width="1064" height="33" as="geometry"/></mxCell><mxCell id="ups-fallback" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="60" y="1640" width="1100" height="230" as="geometry"/></mxCell><mxCell id="ups-fallback-shape" value="" style="rounded=1;arcSize=8;fillColor=#FFF7E9;strokeColor=#A76B20;strokeWidth=1.6;" vertex="1" connectable="0" parent="ups-fallback"><mxGeometry width="1100" height="230" as="geometry"/></mxCell><mxCell id="ups-fallback-text0" value="Если выбранное оборудование не входит" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=27;fontColor=#18354A;fontStyle=1;" vertex="1" parent="ups-fallback"><mxGeometry x="18" y="18" width="1064" height="33" as="geometry"/></mxCell><mxCell id="ups-fallback-text1" value="Предварительный расширенный сценарий: 1000 × 600 × 500 мм*." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-fallback"><mxGeometry x="18" y="60" width="1064" height="33" as="geometry"/></mxCell><mxCell id="ups-fallback-text2" value="Выбор возможен только после проверки модели, АКБ и автономности." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-fallback"><mxGeometry x="18" y="93" width="1064" height="33" as="geometry"/></mxCell><mxCell id="ups-fallback-text3" value="Внешний корпус ИБП не резервирует силовые насосы / ПЧ." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-fallback"><mxGeometry x="18" y="126" width="1064" height="33" as="geometry"/></mxCell><mxCell id="ups-fallback-text4" value="Новые сигналы состояния ИБП и интерфейсы не назначены." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="ups-fallback"><mxGeometry x="18" y="159" width="1064" height="33" as="geometry"/></mxCell><mxCell id="door" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="1240" y="250" width="1200" height="300" as="geometry"/></mxCell><mxCell id="door-shape" value="" style="rounded=1;arcSize=8;fillColor=#FFF7E9;strokeColor=#A76B20;strokeWidth=1.6;" vertex="1" connectable="0" parent="door"><mxGeometry width="1200" height="300" as="geometry"/></mxCell><mxCell id="door-text0" value="Дверь основного щита · условные посадочные зоны" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=28;fontColor=#18354A;fontStyle=1;" vertex="1" parent="door"><mxGeometry x="18" y="18" width="1164" height="34" as="geometry"/></mxCell><mxCell id="door-text1" value="Местный веб-HMI: устройство отображения ещё не выбрано." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="door"><mxGeometry x="18" y="61" width="1164" height="34" as="geometry"/></mxCell><mxCell id="door-text2" value="Для панели на двери условно оставить 350 × 250 × 80 мм*." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="door"><mxGeometry x="18" y="95" width="1164" height="34" as="geometry"/></mxCell><mxCell id="door-text3" value="Это опция размещения, не утверждение обязательной панели." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="door"><mxGeometry x="18" y="129" width="1164" height="34" as="geometry"/></mxCell><mxCell id="door-text4" value="Кнопка «Авария», свет и звук: условная общая зона 250 × 100 мм*." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="door"><mxGeometry x="18" y="163" width="1164" height="34" as="geometry"/></mxCell><mxCell id="door-text5" value="Модели, глубины, отверстия и аппаратная схема — проверить." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="door"><mxGeometry x="18" y="197" width="1164" height="34" as="geometry"/></mxCell><mxCell id="door-text6" value="Зоны на двери располагать вне проекции глубокого ПЧ и его проводов." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="door"><mxGeometry x="18" y="231" width="1164" height="34" as="geometry"/></mxCell><mxCell id="depth" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="1240" y="590" width="1200" height="265" as="geometry"/></mxCell><mxCell id="depth-shape" value="" style="rounded=1;arcSize=8;fillColor=#EDF5FB;strokeColor=#286A9B;strokeWidth=1.6;" vertex="1" connectable="0" parent="depth"><mxGeometry width="1200" height="265" as="geometry"/></mxCell><mxCell id="depth-text0" value="Почему предложена глубина 400 мм" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=28;fontColor=#18354A;fontStyle=1;" vertex="1" parent="depth"><mxGeometry x="18" y="18" width="1164" height="34" as="geometry"/></mxCell><mxCell id="depth-text1" value="ПЧ: 194 мм; с ЛПО1 — ещё 7,6 мм по документации." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="depth"><mxGeometry x="18" y="61" width="1164" height="34" as="geometry"/></mxCell><mxCell id="depth-text2" value="Для оценки принято: 50 мм от задней стенки до плиты" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="depth"><mxGeometry x="18" y="95" width="1164" height="34" as="geometry"/></mxCell><mxCell id="depth-text3" value="+ 201,6 мм ПЧ с ЛПО1 + 100 мм спереди = 351,6 мм*." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="depth"><mxGeometry x="18" y="129" width="1164" height="34" as="geometry"/></mxCell><mxCell id="depth-text4" value="Остаток до внешней глубины 400 мм — не гарантированный зазор." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="depth"><mxGeometry x="18" y="163" width="1164" height="34" as="geometry"/></mxCell><mxCell id="depth-text5" value="Профили, дверь, клеммы и радиусы кабелей проверяются по корпусу." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="depth"><mxGeometry x="18" y="197" width="1164" height="34" as="geometry"/></mxCell><mxCell id="comparison" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="1240" y="895" width="1200" height="300" as="geometry"/></mxCell><mxCell id="comparison-shape" value="" style="rounded=1;arcSize=8;fillColor=#EDF8F4;strokeColor=#277A69;strokeWidth=1.6;" vertex="1" connectable="0" parent="comparison"><mxGeometry width="1200" height="300" as="geometry"/></mxCell><mxCell id="comparison-text0" value="Оценка основного корпуса и чувствительность" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=28;fontColor=#18354A;fontStyle=1;" vertex="1" parent="comparison"><mxGeometry x="18" y="18" width="1164" height="34" as="geometry"/></mxCell><mxCell id="comparison-text1" value="1400 × 1000 × 400 мм*: показанный базовый эскиз." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="comparison"><mxGeometry x="18" y="61" width="1164" height="34" as="geometry"/></mxCell><mxCell id="comparison-text2" value="Резерв размещения 960 / 3680 ≈ 26% полезных длин реек." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="comparison"><mxGeometry x="18" y="95" width="1164" height="34" as="geometry"/></mxCell><mxCell id="comparison-text3" value="1200 × 1000 × 400 мм*: при удалении резервного ряда" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="comparison"><mxGeometry x="18" y="129" width="1164" height="34" as="geometry"/></mxCell><mxCell id="comparison-text4" value="останется 340 / 3060 ≈ 11%; это вариант с малым запасом." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="comparison"><mxGeometry x="18" y="163" width="1164" height="34" as="geometry"/></mxCell><mxCell id="comparison-text5" value="Если занятые зоны увеличатся на 300 мм: резерв ≈18%." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="comparison"><mxGeometry x="18" y="197" width="1164" height="34" as="geometry"/></mxCell><mxCell id="comparison-text6" value="При увеличении на 600 мм: ≈10%; пересмотреть корпус / состав." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="comparison"><mxGeometry x="18" y="231" width="1164" height="34" as="geometry"/></mxCell><mxCell id="rail-not-din" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="1240" y="1235" width="1200" height="230" as="geometry"/></mxCell><mxCell id="rail-not-din-shape" value="" style="rounded=1;arcSize=8;fillColor=#EDF5FB;strokeColor=#286A9B;strokeWidth=1.6;" vertex="1" connectable="0" parent="rail-not-din"><mxGeometry width="1200" height="230" as="geometry"/></mxCell><mxCell id="rail-not-din-text0" value="Резерв шкафа ≠ свободные каналы контроллера" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=28;fontColor=#18354A;fontStyle=1;" vertex="1" parent="rail-not-din"><mxGeometry x="18" y="18" width="1164" height="34" as="geometry"/></mxCell><mxCell id="rail-not-din-text1" value="WB и шесть модулей: 22 DIN; MAP3 + Новатек: ещё 4 DIN." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="rail-not-din"><mxGeometry x="18" y="61" width="1164" height="34" as="geometry"/></mxCell><mxCell id="rail-not-din-text2" value="Подтверждённая модульная часть — 26 DIN, а не весь щит." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="rail-not-din"><mxGeometry x="18" y="95" width="1164" height="34" as="geometry"/></mxCell><mxCell id="rail-not-din-text3" value="ПЧ крепится на плите; остальные сборки имеют неизвестные габариты." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="rail-not-din"><mxGeometry x="18" y="129" width="1164" height="34" as="geometry"/></mxCell><mxCell id="rail-not-din-text4" value="Функциональный запас прежний: DI 0; DO 3; AO 3." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="rail-not-din"><mxGeometry x="18" y="163" width="1164" height="34" as="geometry"/></mxCell><mxCell id="checks" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="1240" y="1505" width="1200" height="365" as="geometry"/></mxCell><mxCell id="checks-shape" value="" style="rounded=1;arcSize=8;fillColor=#FFF7E9;strokeColor=#A76B20;strokeWidth=1.6;" vertex="1" connectable="0" parent="checks"><mxGeometry width="1200" height="365" as="geometry"/></mxCell><mxCell id="checks-text0" value="До выбора корпуса и изготовления" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=28;fontColor=#18354A;fontStyle=1;" vertex="1" parent="checks"><mxGeometry x="18" y="18" width="1164" height="34" as="geometry"/></mxCell><mxCell id="checks-text1" value="Сверить габариты БП, контакторов, TUF, реле с колодками и клемм." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="checks"><mxGeometry x="18" y="61" width="1164" height="34" as="geometry"/></mxCell><mxCell id="checks-text2" value="Завершить силовую схему, аппаратные защиты и решение D-321." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="checks"><mxGeometry x="18" y="95" width="1164" height="34" as="geometry"/></mxCell><mxCell id="checks-text3" value="Проверить глубину и полезную плиту по реальному корпусу." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="checks"><mxGeometry x="18" y="129" width="1164" height="34" as="geometry"/></mxCell><mxCell id="checks-text4" value="Выполнить тепловой расчёт с потерями всех устройств." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="checks"><mxGeometry x="18" y="163" width="1164" height="34" as="geometry"/></mxCell><mxCell id="checks-text5" value="Определить кабели: заполнение коробов, вводы, ЭМС, экраны и PE." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="checks"><mxGeometry x="18" y="197" width="1164" height="34" as="geometry"/></mxCell><mxCell id="checks-text6" value="Разнести цепи ИБП и сети; обеспечить отключение всех источников." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="checks"><mxGeometry x="18" y="231" width="1164" height="34" as="geometry"/></mxCell><mxCell id="checks-text7" value="Подтвердить ИБП, автономность, АКБ, вентиляцию и прочность полки." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="checks"><mxGeometry x="18" y="265" width="1164" height="34" as="geometry"/></mxCell><mxCell id="checks-text8" value="При любом превышении условной зоны пересчитать запас." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#526879;fontStyle=0;" vertex="1" parent="checks"><mxGeometry x="18" y="299" width="1164" height="34" as="geometry"/></mxCell><mxCell id="cabinet-ups-t7-0" value="Основание: D-305–D-311, D-322–D-334; карта I/O и интерфейс проекта. Источники и проверки — README.md." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#526879;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1971" width="2380" height="22" as="geometry"/></mxCell><mxCell id="cabinet-ups-t8-0" value="Названия блоков и линии — функциональные обозначения. Клеммы, адреса, номиналы и монтажные каналы не назначены." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#526879;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1998" width="2380" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
